{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["server/**/*", "client/**/*", "admin/**/*"]
}
