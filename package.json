{
  "name": "vamp",
  "version": "0.1.0",
  "private": true,
  "description": "VAMP — Luau-focused IDE with licensing and sandboxed runtime",
  "main": "./dist/electron/main.js",
  "scripts": {
    "dev:server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev": "npm-run-all --parallel dev:server dev:electron",
    "build:client": "node scripts/build-client.js",
    "build": "npm run build:client && tsc -p .",
    "build:win": "npm run build && electron-builder --win",
    "start": "electron .",
    "lint": "echo 'No linter configured'"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.2",
    "concurrently": "^8.2.0",
    "electron": "^26.6.10",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "monaco-editor": "^0.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.4.2",
    "electron-builder": "^24.6.0",
    "esbuild": "^0.19.0",
    "npm-run-all": "^4.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "wait-on": "^7.0.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "productName": "VAMP",
    "appId": "com.vamp.app",
    "files": [
      "dist/**",
      "client/**",
      "server/**",
      "admin/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true
    }
  }
}
